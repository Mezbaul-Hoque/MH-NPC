# ========== Unity .gitignore ==========

# Ignore Unity-generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
MemoryCaptures/

# Ignore cache packages
Packages/PackageCache/

# Ignore IDE/Editor files
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.user
*.pidb
*.booproj

# OS-specific files
.DS_Store
Thumbs.db

# Others
*.dll
*.dylib
*.so
*.lib
